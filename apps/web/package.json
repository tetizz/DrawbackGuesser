{
  "name": "@drawbackguesser/web",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "predev": "pnpm --workspace-root engine:build && pnpm --filter @drawbackguesser/predictor build",
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@drawbackengine/chess-core": "workspace:*",
    "@drawbackengine/chess-evaluator": "workspace:*",
    "@drawbackengine/drawback-engine": "workspace:*",
    "@drawbackguesser/predictor": "workspace:*",
    "@drawbackengine/shared": "workspace:*",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^7.0.6"
  }
}
