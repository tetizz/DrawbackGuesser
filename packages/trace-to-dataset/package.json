{
  "name": "@drawbackguesser/trace-to-dataset",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "pnpm --filter @drawbackguesser/dataset-contract build && pnpm --filter @drawbackguesser/predictor build && tsc -p tsconfig.build.json",
    "typecheck": "pnpm --filter @drawbackguesser/dataset-contract build && pnpm --filter @drawbackguesser/predictor build && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@drawbackengine/chess-core": "workspace:*",
    "@drawbackengine/drawback-engine": "workspace:*",
    "@drawbackengine/simulation-arena": "workspace:*",
    "@drawbackengine/shared": "workspace:*",
    "@drawbackengine/simulation-trace": "workspace:*",
    "@drawbackguesser/dataset-contract": "workspace:*",
    "@drawbackguesser/predictor": "workspace:*"
  }
}
